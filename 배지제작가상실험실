                    </div>
                    <button onclick="resetCurrentStep()" class="text-xs text-amber-400 hover:text-amber-300 underline font-semibold flex items-center gap-1">
                        <i class="fa-solid fa-arrow-rotate-left text-[10px]"></i> 단계 초기화
                    </button>
                </div>
            </div>

            <!-- Right Side: Instructions & Mission Status Sidebar (4 cols) -->
            <div class="lg:col-span-4 flex flex-col gap-4">
                
                <!-- Current Step Card -->
                <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-xl">
                    <div class="flex items-center justify-between mb-2">
                        <span id="step-badge" class="px-2.5 py-1 rounded-md bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 text-xs font-bold">STEP 1 / 6</span>
