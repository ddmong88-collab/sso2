        function onIncubatorSliderChange(val) {
            incubationTime = parseFloat(val);
            document.getElementById('incubator-timer-display').innerText = incubationTime.toFixed(1) + "시간 경과";
            updateUIMonitors();
        }

        function toggleIncubationAutoPlay() {
            if (isIncubating) {
                stopIncubationTimer();
            } else {
                startIncubationTimer();
            }
        }

        function startIncubationTimer() {
            isIncubating = true;
            document.getElementById('incubation-play-icon').className = "fa-solid fa-pause";
            document.getElementById('incubation-play-text').innerText = "일시정지";

            if (incubationTime >= 24) incubationTime = 0;

            incubationTimerInterval = setInterval(() => {
                if (incubationTime < 24) {
                    incubationTime += 0.5;
                    document.getElementById('incubator-slider').value = incubationTime;
                    document.getElementById('incubator-timer-display').innerText = incubationTime.toFixed(1) + "시간 경과";
                    updateUIMonitors();
                } else {
                    stopIncubationTimer();
                }
            }, 250);
        }

        function stopIncubationTimer() {
            isIncubating = false;
            if (incubationTimerInterval) clearInterval(incubationTimerInterval);
            document.getElementById('incubation-play-icon').className = "fa-solid fa-play";
            document.getElementById('incubation-play-text').innerText = "타임랩스 재생";
        }

        function jumpToStep(step) {
            currentStep = step;
            stopIncubationTimer();
            resetObjectPositions();
            updateStepUI();
        }

        function nextStep() {
            if (currentStep < 6) {
                currentStep++;
                stopIncubationTimer();
                resetObjectPositions();
                updateStepUI();
            } else if (currentStep === 6) {
                openQuizModal();
            }
        }

        function prevStep() {
            if (currentStep > 1) {
                currentStep--;
                stopIncubationTimer();
                resetObjectPositions();
                updateStepUI();
            }
        }

        function resetCurrentStep() {
            stopIncubationTimer();
            if (currentStep === 1) { 
                agarMass = 0; nutrientMass = 0; 
            }
            else if (currentStep === 2) { 
                waterVolume = 0; isStirred = false; stirProgress = 0; cylPouring = false; cylAngle = 0; 
            }
            else if (currentStep === 3) { 
                isAutoclaved = false; autoclaveTemp = 25; isAutoclaveRunning = false; 
            }
            else if (currentStep === 4) { 
                petriVolume = 0; 
            }
            else if (currentStep === 5) { 
                streakPoints = []; spreaderLawn = []; coolTemp = 95; isSolidified = false; 
                loopSterilized = false; loopDippedInCulture = false; loopHeatLevel = 0; dropletPoured = false; spreadCoverage = 0; 
            }
            else if (currentStep === 6) {
                petriInIncubator = false; incubationTime = 0; document.getElementById('incubator-slider').value = 0;
            }
            resetObjectPositions();
            updateStepUI();
        }

        function updateStepUI() {
            let data = stepDetails[currentStep];

            document.getElementById('progress-bar').style.width = (currentStep * (100/6)) + '%';

            // Show/Hide Step 5 / Step 6 Special Control Panels
            let selector5 = document.getElementById('step5-mode-selector');
            let panel6 = document.getElementById('step6-incubator-panel');

            if (currentStep === 5) selector5.classList.remove('hidden');
            else selector5.classList.add('hidden');

            if (currentStep === 6) panel6.classList.remove('hidden');
            else panel6.classList.add('hidden');

            for (let i = 1; i <= 6; i++) {
                let btn = document.getElementById('step-btn-' + i).querySelector('.step-icon');
                if (i === currentStep) {
                    btn.className = "step-icon w-9 h-9 rounded-full bg-cyan-500 text-slate-950 font-bold flex items-center justify-center border-4 border-slate-900 shadow-md transition-all scale-110 text-xs";
                } else if (i < currentStep) {
                    btn.className = "step-icon w-9 h-9 rounded-full bg-emerald-500 text-slate-950 font-bold flex items-center justify-center border-4 border-slate-900 shadow-md transition-all text-xs";
                } else {
                    btn.className = "step-icon w-9 h-9 rounded-full bg-slate-800 text-slate-400 font-bold flex items-center justify-center border-4 border-slate-900 shadow-md transition-all text-xs";
                }
            }

            document.getElementById('step-badge').innerText = `STEP ${currentStep} / 6`;
            document.getElementById('step-title').innerText = data.title;
            document.getElementById('step-desc').innerText = data.desc;
            document.getElementById('hint-text').innerText = data.hint;
            document.getElementById('science-note').innerText = data.note;

            updateMissionList();

            document.getElementById('prev-btn').disabled = (currentStep === 1);
            
            // Step 6 Next Button text change to [실험 종료 & 퀴즈 풀기 🎉]
            let nextBtnText = document.getElementById('next-btn-text');
            let nextBtnIcon = document.getElementById('next-btn-icon');
            let nextBtn = document.getElementById('next-btn');

            if (currentStep === 6) {
                nextBtnText.innerText = "실험 종료 & 퀴즈 풀기";
                nextBtnIcon.className = "fa-solid fa-graduation-cap ml-1";
                nextBtn.className = "flex-1 py-2.5 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-slate-950 font-bold text-xs shadow-lg transition-all flex items-center justify-center gap-1";
            } else {
                nextBtnText.innerText = "다음 단계";
                nextBtnIcon.className = "fa-solid fa-arrow-right ml-1";
                nextBtn.className = "flex-1 py-2.5 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-500 hover:from-cyan-400 hover:to-blue-400 text-slate-950 font-bold text-xs shadow-lg transition-all flex items-center justify-center gap-1";
            }
        }

        function updateMissionList() {
            let data = stepDetails[currentStep];
            let mList = document.getElementById('mission-list');
            
            let status = [false, false];
            if (currentStep === 1) {
                status[0] = agarMass >= 1.5;
                status[1] = nutrientMass >= 2.5;
            } else if (currentStep === 2) {
                status[0] = waterVolume >= 200;
                status[1] = isStirred;
            } else if (currentStep === 3) {
                status[0] = dist(flask.x, flask.y, 260, height - 240) < 110;
                status[1] = isAutoclaved;
            } else if (currentStep === 4) {
                status[0] = petriVolume >= 15;
                status[1] = true;
            } else if (currentStep === 5) {
                if (inoculationMode === 'streak') {
                    status[0] = loopSterilized && loopDippedInCulture;
                    status[1] = streakPoints.length > 5;
                } else {
                    status[0] = dropletPoured;
                    status[1] = spreadCoverage >= 50;
                }
            } else if (currentStep === 6) {
                status[0] = petriInIncubator;
                status[1] = incubationTime >= 20;
            }

            mList.innerHTML = data.missions.map((m, idx) => `
                <li class="flex items-center gap-2 ${status[idx] ? 'text-emerald-400 font-semibold' : 'text-slate-300'}">
                    <i class="${status[idx] ? 'fa-solid fa-circle-check text-emerald-400' : 'fa-regular fa-circle text-cyan-400'}"></i>
                    <span>${m}</span>
                </li>
            `).join('');
        }

        function updateUIMonitors() {
            document.getElementById('scale-value').innerText = (agarMass + nutrientMass).toFixed(2) + " g";
            document.getElementById('beaker-vol').innerText = Math.round(waterVolume) + " mL";
            document.getElementById('petri-vol').innerText = Math.round(petriVolume) + " mL";

            let currentTemp = 25.0;
            if (currentStep === 3) currentTemp = autoclaveTemp;
            else if (currentStep === 5) currentTemp = coolTemp;
            else if (currentStep === 6) currentTemp = 37.0;
            document.getElementById('global-temp').innerText = currentTemp.toFixed(1) + " ℃";

            let sterBadge = document.getElementById('sterilization-status');
            if (currentStep === 5) {
                if (inoculationMode === 'streak') {
                    if (!loopSterilized) sterBadge.innerText = "백금이 미멸균";
                    else if (!loopDippedInCulture) sterBadge.innerText = "화염멸균 완료 / 균액 미접종";
                    else sterBadge.innerText = "대장균 묻히기 완료";
                    sterBadge.className = (loopSterilized && loopDippedInCulture) ? "font-semibold text-emerald-400" : "font-semibold text-amber-400";
                } else {
                    sterBadge.innerText = dropletPoured ? "대장균 균액 주입 완료" : "균액 미주입";
                    sterBadge.className = dropletPoured ? "font-semibold text-emerald-400" : "font-semibold text-amber-400";
                }
            } else if (currentStep === 6) {
                sterBadge.innerText = petriInIncubator ? "37℃ 배양 진행 중" : "배양기 미대기";
                sterBadge.className = petriInIncubator ? "font-semibold text-emerald-400" : "font-semibold text-amber-400";
            } else if (isAutoclaved) {
                sterBadge.innerText = "멸균 완료 (Sterile)";
                sterBadge.className = "font-semibold text-emerald-400";
            } else {
                sterBadge.innerText = "멸균 필요";
                sterBadge.className = "font-semibold text-amber-400";
            }

            updateMissionList();
        }

        // ==========================================
        // 7. INQUIRY QUIZ MODAL LOGIC
        // ==========================================

        function openQuizModal() {
            document.getElementById('quiz-modal').classList.remove('hidden');
        }

        function closeQuizModal() {
            document.getElementById('quiz-modal').classList.add('hidden');
        }

        function renderQuizQuestions() {
            let container = document.getElementById('quiz-container');
            container.innerHTML = quizData.map((q, qIdx) => `
                <div class="bg-slate-950 border border-slate-800 rounded-xl p-4 space-y-3">
                    <h3 class="text-sm font-bold text-slate-100 flex items-start gap-2">
                        <span class="w-5 h-5 rounded-full bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 text-xs flex items-center justify-center shrink-0 mt-0.5">${qIdx + 1}</span>
                        <span>${q.question}</span>
                    </h3>

                    <div class="space-y-2">
                        ${q.options.map((opt, oIdx) => `
                            <button onclick="selectQuizAnswer(${qIdx}, ${oIdx})" id="quiz-opt-${qIdx}-${oIdx}" class="w-full text-left p-3 rounded-lg bg-slate-900 border border-slate-800 hover:bg-slate-800/80 transition-all text-xs text-slate-300 flex items-center gap-2">
                                <span class="w-4 h-4 rounded-full border border-slate-600 flex items-center justify-center text-[10px] font-mono shrink-0">${oIdx + 1}</span>
                                <span>${opt}</span>
                            </button>
                        `).join('')}
                    </div>

                    <div id="quiz-explain-${qIdx}" class="hidden p-3 rounded-lg bg-emerald-950/40 border border-emerald-500/30 text-xs text-emerald-300">
                        <!-- Explanation rendered dynamically -->
                    </div>
                </div>
            `).join('');
        }

        function selectQuizAnswer(qIdx, oIdx) {
            userAnswers[qIdx] = oIdx;
            let q = quizData[qIdx];

            // Style options
            q.options.forEach((_, idx) => {
                let btn = document.getElementById(`quiz-opt-${qIdx}-${idx}`);
                if (idx === q.correct) {
                    btn.className = "w-full text-left p-3 rounded-lg bg-emerald-950/60 border-2 border-emerald-500 text-xs text-emerald-200 font-semibold flex items-center gap-2";
                } else if (idx === oIdx && oIdx !== q.correct) {
                    btn.className = "w-full text-left p-3 rounded-lg bg-rose-950/60 border-2 border-rose-500 text-xs text-rose-300 flex items-center gap-2";
                } else {
                    btn.className = "w-full text-left p-3 rounded-lg bg-slate-900/40 border border-slate-800 text-xs text-slate-500 opacity-60 flex items-center gap-2";
                }
            });

            // Show explanation
            let expBox = document.getElementById(`quiz-explain-${qIdx}`);
            expBox.classList.remove('hidden');
            if (oIdx === q.correct) {
                expBox.className = "p-3 rounded-lg bg-emerald-950/50 border border-emerald-500/40 text-xs text-emerald-300 flex items-start gap-2";
                expBox.innerHTML = `<i class="fa-solid fa-circle-check text-emerald-400 text-sm mt-0.5"></i> <div><strong>정답입니다!</strong> ${q.explanation}</div>`;
            } else {
                expBox.className = "p-3 rounded-lg bg-rose-950/50 border border-rose-500/40 text-xs text-rose-300 flex items-start gap-2";
                expBox.innerHTML = `<i class="fa-solid fa-circle-xmark text-rose-400 text-sm mt-0.5"></i> <div><strong>오답입니다.</strong> ${q.explanation}</div>`;
            }

            checkQuizCompletion();
        }

        function checkQuizCompletion() {
            if (userAnswers.every(ans => ans !== -1)) {
                let correctCount = userAnswers.filter((ans, idx) => ans === quizData[idx].correct).length;
                let summaryPanel = document.getElementById('quiz-summary-panel');
                let scoreText = document.getElementById('quiz-score-text');
                let feedbackText = document.getElementById('quiz-feedback-text');

                summaryPanel.classList.remove('hidden');
                scoreText.innerText = `총 3문제 중 ${correctCount}문제 정답! (${Math.round((correctCount/3)*100)}점)`;

                if (correctCount === 3) {
                    feedbackText.innerText = "🎉 완벽합니다! 배지 제작 원리와 세균 접종 및 배양 개념을 완벽히 마스터하셨습니다.";
                } else if (correctCount >= 1) {
                    feedbackText.innerText = "👍 잘하셨습니다! 오답 해설을 다시 읽어보고 개념을 더욱 단단히 다져보세요.";
                } else {
                    feedbackText.innerText = "💡 가상실험 단계를 복습하고 퀴즈에 다시 도전해 보세요!";
                }
            }
        }

        function resetQuiz() {
            userAnswers = [-1, -1, -1];
            document.getElementById('quiz-summary-panel').classList.add('hidden');
            renderQuizQuestions();
        }

        // Initialize UI
        updateStepUI();
    </script>
</body>
</html>
