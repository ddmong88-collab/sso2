            drawPetriDish(petriX, petriY, 110, petriVolume, "한천 고체 배지 (Agar Plate)");

            if (coolTemp > 25) {
                coolTemp -= 0.3;
            } else {
                isSolidified = true;
            }

            // Draw initial faint streaking/spreading lines
            push();
            for (let pt of spreaderLawn) {
                noStroke();
                fill(254, 240, 138, 120);
                ellipse(pt.x, pt.y, pt.r, pt.r * 0.4);
            }

            stroke(255, 255, 230, 230);
            strokeWeight(3);
            noFill();
            beginShape();
            for (let pt of streakPoints) {
                vertex(pt.x, pt.y);
            }
            endShape();

            for (let i = 0; i < streakPoints.length; i += 4) {
                let pt = streakPoints[i];
                noStroke();
                fill(254, 252, 232, 240);
                ellipse(pt.x, pt.y, 4, 2.5);
            }
            pop();

            let tubeX = 140;
            let tubeY = height - 190;

            if (inoculationMode === 'streak') {
                let lampX = 260;
                let lampY = height - 190;

                drawAlcoholLamp(lampX, lampY);
                drawEcoliTube(tubeX, tubeY);

                if (platinumLoop.dragging) {
                    platinumLoop.x = mouseX;
                    platinumLoop.y = mouseY;
                }

                let loopTipX = platinumLoop.x;
                let loopTipY = platinumLoop.y - 75;

                // 1) Check Flame Sterilization Interaction
                let isTipInFlame = dist(loopTipX, loopTipY, lampX, lampY - 45) < 35;
                if (isTipInFlame) {
                    loopHeatLevel = min(100, loopHeatLevel + 4);
                    loopSterilized = true;
                } else {
                    loopHeatLevel = max(0, loopHeatLevel - 1.5);
                }

                // 2) Check E. coli Tube Dipping Interaction (Must be sterilized first)
                let isTipInTube = dist(loopTipX, loopTipY, tubeX, tubeY) < 35;
                if (isTipInTube && loopSterilized && loopHeatLevel < 30) {
                    loopDippedInCulture = true;
                }

                drawPlatinumLoop(platinumLoop.x, platinumLoop.y, loopHeatLevel, loopDippedInCulture);

                // 3) Check Streaking Interaction (Must be sterilized + dipped)
                let distToPetri = dist(loopTipX, loopTipY, petriX, petriY);
                if (platinumLoop.dragging && distToPetri < 90) {
                    if (loopSterilized && loopDippedInCulture) {
                        streakPoints.push({ x: loopTipX, y: loopTipY });
                    }
                }

                // Visual Tooltip Guidance
                noStroke();
                textAlign(CENTER);
                textSize(12);
                if (!loopSterilized) {
                    fill(251, 146, 60);
                    text("🔥 [1단계] 백금이 팁을 알코올램프 불꽃에 대어 화염 멸균하세요!", lampX, lampY - 80);
                } else if (!loopDippedInCulture) {
                    fill(251, 191, 36);
                    text("🧪 [2단계] 식은 백금이 팁을 대장균 용기에 넣어 세균을 묻히세요!", tubeX, tubeY - 80);
                } else {
                    fill(52, 211, 153);
                    text("✨ [3단계] 백금이 팁을 배지 표면에 대고 획선 도말(Streaking)하세요!", petriX, petriY - 80);
                }

            } else {
                drawEcoliTube(tubeX, tubeY);

                if (dropletPoured) {
                    noStroke();
                    fill(251, 191, 36, 180);
                    ellipse(petriX, petriY, 28, 14);
                }

                if (spreader.dragging) {
                    spreader.x = mouseX;
                    spreader.y = mouseY;
                }

                let spreaderTipX = spreader.x;
                let spreaderTipY = spreader.y - 40;

                drawGlassSpreader(spreader.x, spreader.y);

                let distToPetri = dist(spreaderTipX, spreaderTipY, petriX, petriY);
                if (spreader.dragging && dropletPoured && distToPetri < 85) {
                    spreaderLawn.push({ x: spreaderTipX, y: spreaderTipY, r: random(18, 30) });
                    spreadCoverage = min(100, spreadCoverage + 0.8);
                }

                noStroke();
                textAlign(CENTER);
                textSize(12);
                if (!dropletPoured) {
                    fill(251, 146, 60);
                    text("🧪 대장균 균액 용기를 클릭하여 배지 위에 균액을 떨어뜨리세요.", tubeX + 20, tubeY - 80);
                } else {
                    fill(52, 211, 153);
                    text("✨ 유리 도말봉 팁으로 배지 표면을 문질러 도말하세요. (진행도: " + Math.round(spreadCoverage) + "%)", petriX, petriY - 80);
                }
            }
        }

