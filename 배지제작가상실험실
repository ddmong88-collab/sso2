                </button>

                <!-- Step 5 -->
                <button onclick="jumpToStep(5)" id="step-btn-5" class="relative z-10 flex flex-col items-center gap-1 group">
                    <div class="step-icon w-9 h-9 rounded-full bg-slate-800 text-slate-400 font-bold flex items-center justify-center border-4 border-slate-900 shadow-md transition-all text-xs">5</div>
                    <span class="text-[11px] font-semibold text-slate-400">세균 접종</span>
                </button>

                <!-- Step 6 -->
                <button onclick="jumpToStep(6)" id="step-btn-6" class="relative z-10 flex flex-col items-center gap-1 group">
                    <div class="step-icon w-9 h-9 rounded-full bg-slate-800 text-slate-400 font-bold flex items-center justify-center border-4 border-slate-900 shadow-md transition-all text-xs">6</div>
                    <span class="text-[11px] font-semibold text-slate-400">배양기 배양</span>
                </button>
            </div>
        </div>

        <!-- Main Interactive Workspace -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
            
            <!-- Left Side: Interactive p5 Canvas Area (8 cols) -->
            <div class="lg:col-span-8 flex flex-col gap-3">
                
                <!-- Step 5 Technique Selectors (Visible only in step 5) -->
                <div id="step5-mode-selector" class="hidden bg-slate-900 border border-cyan-500/40 p-2.5 rounded-xl flex items-center justify-between gap-2">
                    <span class="text-xs text-cyan-300 font-semibold flex items-center gap-1.5">
                        <i class="fa-solid fa-vial-circle-check"></i> 도말 기법 선택:
                    </span>
                    <div class="flex gap-2">
                        <button onclick="selectInoculationMode('streak')" id="btn-mode-streak" class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all bg-cyan-500 text-slate-950 shadow-md">
                            <i class="fa-solid fa-fire-flame-curved mr-1"></i> 1. 백금이 화염 획선 도말 (Streaking)
                        </button>
                        <button onclick="selectInoculationMode('spreader')" id="btn-mode-spreader" class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all bg-slate-800 text-slate-300 hover:bg-slate-700">
                            <i class="fa-solid fa-spray-can-sparkles mr-1"></i> 2. 도말봉 유리 도말 (Spreading)
                        </button>
                    </div>
                </div>

                <!-- Step 6 Incubator Control Panel (Visible only in step 6) -->
                <div id="step6-incubator-panel" class="hidden bg-slate-900 border border-emerald-500/40 p-3 rounded-xl flex items-center justify-between gap-4">
