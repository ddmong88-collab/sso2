            let btnSpreader = document.getElementById('btn-mode-spreader');

            if (mode === 'streak') {
                btnStreak.className = "px-3 py-1.5 rounded-lg text-xs font-bold transition-all bg-cyan-500 text-slate-950 shadow-md";
                btnSpreader.className = "px-3 py-1.5 rounded-lg text-xs font-bold transition-all bg-slate-800 text-slate-300 hover:bg-slate-700";
            } else {
                btnSpreader.className = "px-3 py-1.5 rounded-lg text-xs font-bold transition-all bg-cyan-500 text-slate-950 shadow-md";
                btnStreak.className = "px-3 py-1.5 rounded-lg text-xs font-bold transition-all bg-slate-800 text-slate-300 hover:bg-slate-700";
