    <!-- p5.js Simulation Logic Script -->
    <script>
        // ==========================================
        // 1. GLOBAL LAB STATE & STEP CONFIGURATIONS
        // ==========================================
        let currentStep = 1;
        let isSafetyChecked = false;

        // Measurement & Physics Values
        let agarMass = 0;       // Target: 1.5g
        let nutrientMass = 0;   // Target: 2.5g
        let waterVolume = 0;    // Target: 200mL
        let isStirred = false;  // Stirring status
        let stirProgress = 0;   // 0 to 100
