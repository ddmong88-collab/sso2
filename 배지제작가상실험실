                    <button onclick="toggleIncubationAutoPlay()" id="btn-incubation-play" class="px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all bg-emerald-500 text-slate-950 hover:bg-emerald-400 shadow-md flex items-center gap-1.5">
                        <i class="fa-solid fa-play" id="incubation-play-icon"></i>
                        <span id="incubation-play-text">타임랩스 재생</span>
