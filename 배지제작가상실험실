        function renderStep2Scene() {
            push();
            translate(cyl.x, cyl.y);
            rotate(radians(cylAngle));
            drawGraduatedCylinderContent(200 - waterVolume);
            pop();

            if (flaskShakeTimer > 0) {
                flaskShakeTimer--;
                flaskShakeOffset = sin(frameCount * 0.8) * 12;
            } else {
                flaskShakeOffset = 0;
            }

            push();
            translate(flask.x + flaskShakeOffset, flask.y);
            let mixColor = color(251, 191, 36, isStirred ? 220 : 130);
            drawErlenmeyerFlaskShape(waterVolume, mixColor, "삼각플라스크 (클릭 시 흔들기)");
            pop();

            if (cylPouring) {
                if (cylAngle < 55) {
                    cylAngle += 3;
                } else if (waterVolume < 200) {
                    waterVolume += 4;
                    stroke(56, 189, 248, 200);
                    strokeWeight(4);
                    line(cyl.x + 35, cyl.y - 80, flask.x - 10, flask.y - 40);
