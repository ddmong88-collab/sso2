        function polygon(x, y, radius, npoints) {
            let angle = TWO_PI / npoints;
            beginShape();
            for (let a = 0; a < TWO_PI; a += angle) {
                let sx = x + cos(a) * radius;
                let sy = y + sin(a) * radius;
                vertex(sx, sy);
            }
            endShape(CLOSE);
        }

        // ==========================================
        // 5. MOUSE INTERACTION & EVENT HANDLERS
        // ==========================================

        function mousePressed() {
            if (!isSafetyChecked) return;

            if (currentStep === 1) {
                if (dist(mouseX, mouseY, spoonAgar.x, spoonAgar.y) < 35) spoonAgar.dragging = true;
                if (dist(mouseX, mouseY, spoonNutrient.x, spoonNutrient.y) < 35) spoonNutrient.dragging = true;
            } else if (currentStep === 2) {
                if (dist(mouseX, mouseY, cyl.x, cyl.y) < 60) {
                    cylPouring = true;
                }
                if (dist(mouseX, mouseY, flask.x, flask.y) < 60 && waterVolume >= 200) {
                    flaskShakeTimer = 15;
                    stirProgress = min(100, stirProgress + 20);
                    if (stirProgress >= 100) isStirred = true;
                }
            } else if (currentStep === 3) {
                if (dist(mouseX, mouseY, flask.x, flask.y) < 60) {
                    flask.dragging = true;
                }
                let isInsideAuto = dist(flask.x, flask.y, 260, height - 240) < 110;
                if (isInsideAuto && mouseX > width - 250 && mouseX < width - 50 && mouseY > height - 240 && mouseY < height - 190) {
                    isAutoclaveRunning = true;
                }
            } else if (currentStep === 4) {
                if (dist(mouseX, mouseY, flask.x, flask.y) < 60) {
                    flask.dragging = true;
                }
            } else if (currentStep === 5) {
                if (inoculationMode === 'streak') {
                    if (dist(mouseX, mouseY, platinumLoop.x, platinumLoop.y) < 50) {
                        platinumLoop.dragging = true;
                    }
                } else {
                    if (dist(mouseX, mouseY, spreader.x, spreader.y) < 50) {
                        spreader.dragging = true;
                    }
                    if (dist(mouseX, mouseY, 140, height - 190) < 40) {
                        dropletPoured = true;
                    }
                }
            } else if (currentStep === 6) {
                if (!petriInIncubator && dist(mouseX, mouseY, petriDishStep6.x, petriDishStep6.y) < 60) {
                    petriDishStep6.dragging = true;
                }
            }
        }

        function mouseDragged() {
            if (!isSafetyChecked) return;

            if (currentStep === 3 && flask.dragging) {
                flask.x = mouseX;
                flask.y = mouseY;
            } else if (currentStep === 4 && flask.dragging) {
                flask.x = mouseX;
                flask.y = mouseY;
            } else if (currentStep === 5) {
                if (inoculationMode === 'streak' && platinumLoop.dragging) {
                    platinumLoop.x = mouseX;
                    platinumLoop.y = mouseY;
                } else if (inoculationMode === 'spreader' && spreader.dragging) {
                    spreader.x = mouseX;
                    spreader.y = mouseY;
                }
            } else if (currentStep === 6 && petriDishStep6.dragging) {
                petriDishStep6.x = mouseX;
                petriDishStep6.y = mouseY;
            }
        }

        function mouseReleased() {
            spoonAgar.dragging = false;
            spoonNutrient.dragging = false;
            flask.dragging = false;
            platinumLoop.dragging = false;
            spreader.dragging = false;
            petriDishStep6.dragging = false;

            if (currentStep === 1) {
                spoonAgar.x = spoonAgar.ox; spoonAgar.y = spoonAgar.oy;
                spoonNutrient.x = spoonNutrient.ox; spoonNutrient.y = spoonNutrient.oy;
            }
        }

