                <div id="progress-bar" class="absolute left-0 top-1/2 -translate-y-1/2 h-1 bg-gradient-to-r from-cyan-500 to-emerald-500 w-[16.6%] rounded-full transition-all duration-500 -z-0"></div>

                <!-- Step 1 -->
                <button onclick="jumpToStep(1)" id="step-btn-1" class="relative z-10 flex flex-col items-center gap-1 group">
                    <div class="step-icon w-9 h-9 rounded-full bg-cyan-500 text-slate-950 font-bold flex items-center justify-center border-4 border-slate-900 shadow-md transition-all scale-110 text-xs">1</div>
                    <span class="text-[11px] font-semibold text-cyan-400">시약 계량</span>
                </button>

                <!-- Step 2 -->
                <button onclick="jumpToStep(2)" id="step-btn-2" class="relative z-10 flex flex-col items-center gap-1 group">
                    <div class="step-icon w-9 h-9 rounded-full bg-slate-800 text-slate-400 font-bold flex items-center justify-center border-4 border-slate-900 shadow-md transition-all text-xs">2</div>
                    <span class="text-[11px] font-semibold text-slate-400">용해 & 혼합</span>
                </button>

                <!-- Step 3 -->
                <button onclick="jumpToStep(3)" id="step-btn-3" class="relative z-10 flex flex-col items-center gap-1 group">
                    <div class="step-icon w-9 h-9 rounded-full bg-slate-800 text-slate-400 font-bold flex items-center justify-center border-4 border-slate-900 shadow-md transition-all text-xs">3</div>
                    <span class="text-[11px] font-semibold text-slate-400">고압 멸균</span>
