                    <button onclick="closeQuizModal()" class="px-5 py-2 bg-gradient-to-r from-emerald-500 to-cyan-500 hover:from-emerald-400 hover:to-cyan-400 text-slate-950 text-xs font-bold rounded-xl shadow-lg transition-all flex items-center gap-1.5">
