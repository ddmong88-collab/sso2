            if (nutrientMass > 0) {
                fill(217, 119, 6, 220);
                ellipse(width/2 + 10, height - 177, map(nutrientMass, 0, 3, 0, 28));
            }

            drawChemicalJar(120, height - 230, "한천 (Agar)", color(254, 243, 199));
