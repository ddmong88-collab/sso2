        // Helper to render colony growth inside Petri Dish based on time (0h ~ 24h)
        function drawIncubatedPetriContent(x, y, radius, hours) {
            push();
            translate(x, y);

            // Base Dish
            stroke(203, 213, 225, 180);
            strokeWeight(2);
            fill(245, 158, 11, 230); // Solidified agar color
            ellipse(0, 0, radius * 2, radius * 0.8);

            // Colony visibility factor (starts appearing after 6h, peaks at 24h)
            let growthProgress = map(constrain(hours, 6, 24), 6, 24, 0, 1);

            if (growthProgress > 0) {
                if (inoculationMode === 'streak') {
                    // Streaking Bacterial Colonies Growth
                    stroke(254, 252, 232, 200 * growthProgress);
                    strokeWeight(map(growthProgress, 0, 1, 1, 5));
                    noFill();
                    beginShape();
                    for (let pt of streakPoints) {
                        let rx = map(pt.x, width/2 - 90, width/2 + 90, -radius + 10, radius - 10);
                        let ry = map(pt.y, height - 290, height - 110, -radius*0.35, radius*0.35);
                        vertex(rx, ry);
                    }
                    endShape();

                    noStroke();
                    fill(255, 251, 235, 240 * growthProgress);
                    for (let i = 0; i < streakPoints.length; i += 3) {
                        let pt = streakPoints[i];
                        let rx = map(pt.x, width/2 - 90, width/2 + 90, -radius + 10, radius - 10);
                        let ry = map(pt.y, height - 290, height - 110, -radius*0.35, radius*0.35);
                        let colonySize = map(growthProgress, 0, 1, 1, random(4, 7));
                        ellipse(rx, ry, colonySize, colonySize * 0.5);
                    }

                } else {
                    // Spreading Bacterial Lawn Growth
                    for (let pt of spreaderLawn) {
                        let rx = map(pt.x, width/2 - 80, width/2 + 80, -radius + 15, radius - 15);
                        let ry = map(pt.y, height - 280, height - 120, -radius*0.3, radius*0.3);
                        noStroke();
                        fill(254, 240, 138, 160 * growthProgress);
                        ellipse(rx, ry, pt.r * growthProgress, pt.r * 0.4 * growthProgress);
                    }
                }
            }

            // Petri Dish Glass Cover Effect
            stroke(255, 255, 255, 120);
            strokeWeight(1.5);
            noFill();
            ellipse(2, -4, radius * 2 + 4, radius * 0.8 + 4);

            noStroke();
            fill(203, 213, 225);
            textSize(11);
            textAlign(CENTER);
            text("37℃ 대장균 배양 배지 (" + hours.toFixed(1) + "h)", 0, radius * 0.4 + 16);

            pop();
        }

